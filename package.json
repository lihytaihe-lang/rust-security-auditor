{
  "name": "rust-security-auditor",
  "version": "0.1.1",
  "description": "Local MCP server for focused Rust security review in Codex and MCP clients.",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "rust-security-auditor-mcp": "./dist/src/mcp/server.js",
    "rust-security-auditor-mcp-call": "./dist/src/mcp/debug.js"
  },
  "exports": {
    ".": "./dist/src/index.js",
    "./mcp": "./dist/src/mcp/index.js",
    "./reports": "./dist/src/reports/index.js",
    "./scanners": "./dist/src/scanners/index.js",
    "./git": "./dist/src/git/index.js",
    "./utils/shell": "./dist/src/utils/shell.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "npm run typecheck",
    "mcp": "npm --silent run build && node dist/src/mcp/server.js",
    "mcp:call": "npm --silent run build && node dist/src/mcp/debug.js",
    "test": "npm run build && find dist/test -name '*.test.js' -type f -print0 | xargs -0 node --test",
    "check": "npm run typecheck && npm test && git diff --check",
    "prepack": "npm run build",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "rust",
    "security",
    "audit",
    "security-audit",
    "codex",
    "mcp",
    "model-context-protocol",
    "static-analysis",
    "unsafe-rust",
    "supply-chain"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/lihytaihe-lang/rust-security-auditor.git"
  },
  "bugs": {
    "url": "https://github.com/lihytaihe-lang/rust-security-auditor/issues"
  },
  "homepage": "https://github.com/lihytaihe-lang/rust-security-auditor#readme",
  "files": [
    "dist/src/",
    "examples/",
    "skills/",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "ROADMAP.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  }
}
